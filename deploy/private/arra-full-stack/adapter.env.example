# Copy outside the repository to /etc/arra-oracle/hermes.env (mode 600).
# This file is intentionally separate: the adapter never receives Mint's
# bearer/MCP token and never needs an OpenAI API key for inference.
ARRA_LLM_PROVIDERS=hermes,codex
ARRA_LLM_MAX_RETRIES=2
ARRA_LLM_TIMEOUT_MS=30000
ARRA_LLM_MAX_CONCURRENCY=2
ARRA_LLM_MIN_INTERVAL_MS=0
ARRA_LLM_MAX_OUTPUT_TOKENS=700

# Hermes gateway's private loopback API key. This is not the xAI OAuth token.
HERMES_API_KEY=generate-a-random-mode-600-value
HERMES_MODEL=grok-4.7
HERMES_CHAT_URL=http://127.0.0.1:8642/v1/chat/completions

# Optional Codex CLI bridge. It runs locally on Mint with read-only codex exec.
CODEX_BRIDGE_KEY=generate-a-second-random-mode-600-value
# Optional; omitted means the locally configured Codex CLI model.
# CODEX_MODEL=gpt-6-astra
CODEX_CHAT_URL=http://127.0.0.1:47781/v1/chat/completions
