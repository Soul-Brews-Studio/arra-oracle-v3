# Copy outside the repository to /etc/arra-oracle/codex-bridge.env (mode 600).
# This file contains only the local bridge secret and non-secret execution
# bounds. It never contains Arra/MCP bearer credentials or the Codex OAuth data.
# Must equal CODEX_BRIDGE_KEY in /etc/arra-oracle/hermes.env.
CODEX_BRIDGE_KEY=generate-a-random-mode-600-value
CODEX_BRIDGE_PORT=47781
# Optional: pin a model accepted by the locally logged-in Codex CLI.
# CODEX_MODEL=gpt-6-astra
CODEX_BIN=/home/poramateake/.local/bin/codex
CODEX_WORKDIR=/home/poramateake/.local/share/arra-codex-bridge/work
CODEX_BRIDGE_TMPDIR=/home/poramateake/.local/share/arra-codex-bridge/tmp
CODEX_TIMEOUT_SECONDS=90
