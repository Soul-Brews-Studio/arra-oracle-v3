---
import Base from "../layouts/Base.astro";
import McpToolBrowser from "../components/McpToolBrowser";
import ServerStatusDashboard from "../components/ServerStatusDashboard";
---

<Base title="MCP Tools | Neo ARRA V3">
  <main class="mx-auto max-w-6xl px-6 py-20">
    <div class="mb-12">
      <a href="/" class="text-sm text-gray-500 transition-colors hover:text-teal-300">← home</a>
      <h1 class="mb-3 mt-4 text-5xl font-bold tracking-tight">MCP Tools</h1>
      <p class="text-lg text-gray-400">Browse live MCP schemas and plugin server health from your connected backend.</p>
    </div>

    <div class="space-y-8">
      <McpToolBrowser client:load />
      <ServerStatusDashboard client:load />
    </div>

    <div class="mt-12 border-t border-gray-800 pt-8">
      <a href="/canvas" class="text-sm text-purple-300 transition-colors hover:text-purple-200">Try the Canvas →</a>
    </div>
  </main>
</Base>
