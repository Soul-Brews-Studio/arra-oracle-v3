---
import Base from "../layouts/Base.astro";
import VectorSearchWidget from "../components/VectorSearchWidget";
---

<Base title="Vector Search | Neo ARRA V3">
  <main class="mx-auto max-w-3xl px-6 py-16">
    <a href="/" class="text-sm text-gray-500 transition-colors hover:text-teal-300">← home</a>
    <h1 class="mb-3 mt-4 text-5xl font-bold tracking-tight">Vector Search</h1>
    <p class="mb-8 text-gray-400">Query the live vector surface through <code class="text-teal-300">/api/vector/search</code>.</p>
    <VectorSearchWidget client:load />
  </main>
</Base>
