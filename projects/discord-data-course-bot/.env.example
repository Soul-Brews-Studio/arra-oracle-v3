# Discord Data Course Bot — V1 slice
#
# These are placeholders. NEVER commit real values here.

# Discord bot token (Discord Developer Portal > Applications > your app > Bot > Token).
# The bot needs the "Message Content Intent" enabled in the same page.
DISCORD_BOT_TOKEN=REPLACE_ME

# Anthropic API key (console.anthropic.com > API Keys). Used to answer student
# questions grounded in the course curriculum (see src/course.ts).
ANTHROPIC_API_KEY=REPLACE_ME

# Comma-separated Discord channel IDs where the bot answers every message
# without needing an @mention (e.g. a dedicated #ask-the-bot channel).
# Outside these channels, the bot only responds when @mentioned. Leave empty
# to require an @mention everywhere.
DISCORD_COURSE_CHANNEL_IDS=

# SQLite DB file path (Drizzle) — stores each topic thread's conversation
# history so students can keep talking about their specific question across
# bot restarts. Directory is created automatically if missing.
DISCORD_BOT_DB_PATH=./data/discord-bot.sqlite

# --- Optional: use a different Anthropic-compatible provider instead of ---
# --- Anthropic directly (e.g. z.ai's GLM models) ---
#
# The Anthropic SDK reads ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN itself —
# no code changes needed. To switch to z.ai:
#   1. Leave ANTHROPIC_API_KEY above EMPTY (both set at once causes a 401 —
#      the SDK sends both headers and the API rejects the request).
#   2. Uncomment and fill in the three lines below with your z.ai API key.
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# ANTHROPIC_AUTH_TOKEN=REPLACE_ME_WITH_ZAI_API_KEY
# AI_MODEL=GLM-4.7
