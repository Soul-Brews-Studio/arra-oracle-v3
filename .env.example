# Oracle v2 Environment Variables
# Copy to .env and fill in values

# Server
PORT=47778
ORACLE_SESSION_SECRET=           # Random string for session signing (auto-generated if empty)
CORS_ORIGIN=                     # Allowed CORS origin for production (e.g., https://yourdomain.com)

# Database
ORACLE_DATA_DIR=                 # Path to Oracle data directory (default: ~/.oracle)

# Vector Store (choose one)
CHROMA_URL=http://localhost:8000
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embeddings
OPENAI_API_KEY=                  # For OpenAI embeddings
OLLAMA_BASE_URL=http://localhost:11434  # For local Ollama embeddings

# Cloudflare (optional)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ORACLE_EMBEDDING_MODEL=

# Forum (optional)
ORACLE_FORUM_REPO=               # GitHub repo for forum sync (e.g., owner/repo)

# Source mappings (optional JSON)
ORACLE_SOURCE_MAPPINGS=          # e.g., {"key":"github.com/owner/repo"}

# x402 paid API (optional — POST /api/x402/ask stays disabled until set)
X402_PAYOUT_ADDRESS=             # Your EVM wallet address (0x...), receives payment only, no private key needed here
X402_NETWORK=eip155:84532        # eip155:84532 = Base Sepolia (testnet, default); eip155:8453 = Base mainnet
X402_PRICE=0.01                  # Price per /api/x402/ask call, in USD (no $ — some .env loaders expand $0 as a variable)
X402_FACILITATOR_URL=https://x402.org/facilitator
